# Credenciais da API oficial da Yampi (painel → Configurações → API). Nunca versione o .env.
ALIAS=sua-loja-de-teste
USER_TOKEN=
USER_SECRET_KEY=
# Única loja em que scripts/yampi-catalog-request aceita operar.
YAMPI_ALLOWED_ALIAS=sua-loja-de-teste
# Pasta local com os arquivos do tema (padrão: tema).
THEME_DIR=tema
