#!/usr/bin/env bash
set -euo pipefail
root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for env_file in "$root_dir/.env" "$root_dir/.env.txt"; do
  if [[ -f "$env_file" ]]; then
    set -a
    source <(tr -d '\r' < "$env_file")
    set +a
    break
  fi
done
: "${USER_TOKEN:?USER_TOKEN ausente}" "${USER_SECRET_KEY:?USER_SECRET_KEY ausente}" "${ALIAS:?ALIAS ausente}"
# Trava de segurança: só opera na loja indicada em YAMPI_ALLOWED_ALIAS (ex.: a loja de teste).
: "${YAMPI_ALLOWED_ALIAS:?YAMPI_ALLOWED_ALIAS ausente: defina a única loja em que este utilitário pode escrever}"
[[ "$ALIAS" == "$YAMPI_ALLOWED_ALIAS" ]] || { echo "Este utilitário está limitado à loja $YAMPI_ALLOWED_ALIAS." >&2; exit 1; }
method="${1:?Método ausente}"
resource="${2:?Recurso ausente}"
[[ ( "$resource" == catalog/* || "$resource" == pricing/combos* || "$resource" == logistics/stocks* || "$resource" == content/pages || "$resource" == content/pages\?* || "$resource" =~ ^content/pages/[0-9]+$ ) && "$resource" != *..* ]] || exit 1
request_args=(--request "$method" --header "User-Token: $USER_TOKEN" --header "User-Secret-Key: $USER_SECRET_KEY" --header 'Content-Type: application/json')
if [[ $# -gt 2 ]]; then request_args+=(--data-binary "@$3"); fi
curl --fail-with-body --silent --show-error --connect-timeout 20 --max-time 90 "${request_args[@]}" "https://api.dooki.com.br/v2/$ALIAS/$resource"
