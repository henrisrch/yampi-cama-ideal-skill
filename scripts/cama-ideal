#!/usr/bin/env python3
"""Cama Ideal — leitura das camas na Yampi e marcações "+" no tema.

Usado pela skill skills/cama-ideal/SKILL.md.
- Camas, produtos e textos: API de catálogo (scripts/yampi-catalog-request).
- Marcações "+": arquivo do tema <THEME_DIR>/elements/cama-ideal-marcacoes.twig,
  enviado ao preview por scripts/yampi-store-file (a Yampi apaga data-* da
  descrição de categoria, por isso as marcações vivem no código da loja).
Escrita só com --aplicar; sem ela, mostra o que mudaria.

  scripts/cama-ideal status                       # todas as camas e pendências
  scripts/cama-ideal ver <slug>                   # detalhe de uma cama
  scripts/cama-ideal pontos <slug>                # marcações atuais (JSON)
  scripts/cama-ideal salvar-pontos <arquivo> [<slug>] [--aplicar]
        <arquivo>: texto copiado da ferramenta ("Salvar marcações da …" + JSON)
  scripts/cama-ideal tirar-pontos <slug> [--aplicar]
  scripts/cama-ideal criar <arquivo> [--aplicar]
        <arquivo>: texto copiado da ferramenta ("Criar cama nova …" + JSON) ou JSON do modelo
        cria (ou completa) a subcategoria da cama: nome, slug, resumo,
        "O que transforma…", capa, ordem, destaque e vincula os produtos.
        Modelo em skills/cama-ideal/modelo-cama-nova.json.

Opção global: --raiz <slug da categoria Cama Ideal> (padrão: cama-do-mes).
Enviar ao preview não publica o tema: a loja publicada só muda ao publicar.
"""
import difflib
import html
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
REQUEST = ROOT / 'scripts' / 'yampi-catalog-request'
STORE_FILE = ROOT / 'scripts' / 'yampi-store-file'
THEME = ROOT / os.environ.get('THEME_DIR', 'tema')  # pasta local do tema (variável THEME_DIR)
MARKS_PATH = 'elements/cama-ideal-marcacoes.twig'
MARKS_RE = re.compile(r'(macro\s+marcacoes\(\)\s*%\}\{\{\s*\(\s*\n)(.*?)(\n\s*\)\s*\|\s*json_encode)', re.S)
# Campos devolvidos pelo GET que voltam no PUT (PUT sem slug regenera o slug).
PUT_FIELDS = ('active', 'name', 'slug', 'parent_id', 'featured', 'order', 'description', 'sort_by', 'external_url')


def api(method, resource, payload=None):
    if method == 'GET':  # leitura com parâmetro único: a API devolve cache antigo após escrita
        resource += ('&' if '?' in resource else '?') + f'_pde_read={time.time_ns()}'
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json') as f:
        command = ['bash', str(REQUEST), method, resource]
        if payload is not None:
            json.dump(payload, f, ensure_ascii=False)
            f.flush()
            command.append(f.name)
        result = subprocess.run(command, capture_output=True, text=True)
    time.sleep(1.1)  # limite de 60 req/min
    if result.returncode:
        sys.exit(f'Erro na API ({method} {resource.split("?")[0]}): {(result.stdout or result.stderr)[:600]}')
    data = json.loads(result.stdout)
    return data.get('data', data)


def categories():
    return api('GET', 'catalog/categories?limit=100')


def camas(raiz):
    cats = categories()
    root = next((c for c in cats if c['slug'] == raiz), None)
    if not root:
        sys.exit(f'Categoria raiz "{raiz}" não encontrada. Use --raiz <slug>.')
    children = sorted((c for c in cats if c.get('parent_id') == root['id']), key=lambda c: (c.get('order') or 0, c['name']))
    return root, children


def find_cama(raiz, slug):
    root, children = camas(raiz)
    cama = next((c for c in children if c['slug'] == slug), None)
    if not cama:
        sys.exit(f'Cama "{slug}" não encontrada em {raiz}. Disponíveis: {", ".join(c["slug"] for c in children) or "nenhuma"}')
    return root, cama


def products(cama_id):
    return api('GET', f'catalog/categories/{cama_id}/products?limit=100')


def description_parts(description):
    """Resumo (1º <p>) e o bloco "O que transforma…" (pergunta, nº de itens)."""
    rest = (description or '').strip()
    first = re.match(r'\s*<p\b[^>]*>(.*?)</p>', rest, re.S | re.I)
    summary = html.unescape(re.sub(r'<[^>]+>', '', first.group(1))).strip() if first else ''
    after = rest[first.end():] if first else rest
    question = re.search(r'<h[1-3]\b[^>]*>(.*?)</h[1-3]>', after, re.S | re.I)
    items = len(re.findall(r'<p\b[^>]*>\s*<(strong|b)\b', after, re.I))
    return summary, (html.unescape(re.sub(r'<[^>]+>', '', question.group(1))).strip() if question else ''), items


def page_url(cama):
    return f"{cama.get('url', '').split('?')[0]}?preview=true"


# ---------- marcações no tema ----------

def store_file(*args, capture=True):
    result = subprocess.run(['bash', str(STORE_FILE), *args], capture_output=capture, cwd=ROOT)
    return result


def read_marks_text(source='local'):
    if source == 'local':
        path = THEME / MARKS_PATH
        if not path.exists():
            sys.exit(f'Arquivo {MARKS_PATH} não existe no tema local.')
        return path.read_text(encoding='utf-8')
    result = store_file('get-current', MARKS_PATH)
    if result.returncode:
        sys.exit(f'Não consegui ler {MARKS_PATH} do preview: {(result.stdout or result.stderr)[:300]!r}')
    return result.stdout.decode('utf-8')


def parse_marks(text):
    match = MARKS_RE.search(text)
    if not match:
        sys.exit(f'{MARKS_PATH}: não achei o JSON dentro da macro marcacoes().')
    try:
        data = json.loads(match.group(2))
    except json.JSONDecodeError as error:
        sys.exit(f'{MARKS_PATH}: JSON inválido ({error}).')
    return data if isinstance(data, dict) else {}


def render_marks(text, marks):
    lines = []
    for index, (slug, points) in enumerate(marks.items()):
        lines.append(f'    {json.dumps(slug, ensure_ascii=False)}: [')
        for n, point in enumerate(points):
            comma = ',' if n < len(points) - 1 else ''
            lines.append('        ' + json.dumps(point, ensure_ascii=False).replace('{"', '{ "').replace('}', ' }').replace('":', '":').replace(', "', ', "') + comma)
        lines.append('    ]' + (',' if index < len(marks) - 1 else ''))
    body = '{\n' + '\n'.join(lines) + ('\n' if lines else '') + '}'
    return MARKS_RE.sub(lambda m: m.group(1) + body + m.group(3), text, count=1)


def number(value):
    value = round(float(value), 1)
    if not 0 <= value <= 100:
        raise ValueError
    return int(value) if value == int(value) else value


def normalize(points):
    out = []
    for point in points:
        produto = str(point.get('produto', '')).strip()
        try:
            x, y = number(point['x']), number(point['y'])
        except (KeyError, TypeError, ValueError):
            sys.exit(f'Marcação inválida (x/y de 0 a 100 obrigatórios): {point}')
        if not re.fullmatch(r'[a-z0-9]+(?:-[a-z0-9]+)*', produto):
            sys.exit(f'Produto inválido na marcação: {produto!r}')
        item = {'produto': produto, 'x': x, 'y': y}
        if point.get('mx') is not None and point.get('my') is not None:
            try:
                mx, my = number(point['mx']), number(point['my'])
            except (TypeError, ValueError):
                sys.exit(f'Posição de celular inválida: {point}')
            if (mx, my) != (x, y):
                item.update(mx=mx, my=my)
        out.append(item)
    return out


def parse_request(text):
    """Texto copiado da ferramenta: 'Salvar marcações da …' + JSON {cama, marcacoes}."""
    start = text.find('{')
    if start < 0:
        sys.exit('Não achei as marcações no texto. Cole exatamente o que a ferramenta copiou.')
    try:
        data, _end = json.JSONDecoder().raw_decode(text[start:])
    except json.JSONDecodeError as error:
        sys.exit(f'As marcações estão incompletas ({error}). Copie de novo na ferramenta.')
    if not isinstance(data, dict) or not isinstance(data.get('marcacoes'), list):
        sys.exit('Formato inesperado: falta "marcacoes".')
    return str(data.get('cama', '')).strip(), data['marcacoes']


def fmt_point(point):
    text = f'computador {point["x"]},{point["y"]}'
    if 'mx' in point:
        text += f' · celular {point["mx"]},{point["my"]}'
    return text


# ---------- checagens e comandos ----------

def check(cama, items, points):
    issues = []
    summary, question, _n = description_parts(cama.get('description'))
    slugs = {p['slug'] for p in items}
    if not cama.get('active'):
        issues.append('subcategoria inativa (não aparece na loja)')
    if not cama.get('category_cover'):
        issues.append('sem capa na subcategoria — a foto vem de um banner com o mesmo slug, se houver')
    if not items:
        issues.append('nenhum produto na subcategoria')
    if not summary:
        issues.append('sem resumo (1º parágrafo da descrição)')
    if not question:
        issues.append('sem bloco "O que transforma…" (título + itens em negrito)')
    if not points:
        issues.append('sem marcações "+" na foto')
    for p in points:
        if p['produto'] not in slugs:
            issues.append(f'marcação de "{p["produto"]}", que não está nesta subcategoria (não aparece)')
    if points:
        for s in sorted(slugs - {p['produto'] for p in points}):
            issues.append(f'produto sem marcação (ok se não aparece na foto): {s}')
    return issues


def cmd_status(raiz):
    root, children = camas(raiz)
    marks = parse_marks(read_marks_text())
    print(f'Cama Ideal: {root["name"]} ({root["slug"]}) — {len(children)} cama(s)\n')
    for cama in children:
        items = products(cama['id'])
        points = marks.get(cama['slug'], [])
        flags = ['destaque' if cama.get('featured') else '', 'ativa' if cama.get('active') else 'INATIVA']
        print(f'• {cama["name"]} — {cama["slug"]} (ordem {cama.get("order") or 0}; {", ".join(f for f in flags if f)})')
        print(f'  {len(items)} produto(s), {len(points)} marcação(ões) — {page_url(cama)}')
        for issue in check(cama, items, points):
            print(f'  ⚠ {issue}')
        print()


def cmd_ver(raiz, slug):
    _root, cama = find_cama(raiz, slug)
    items = products(cama['id'])
    points = parse_marks(read_marks_text()).get(slug, [])
    summary, question, n_items = description_parts(cama.get('description'))
    by_slug = {p['produto']: p for p in points}
    print(f'{cama["name"]} — {cama["slug"]} (id {cama["id"]})')
    print(f'Página: {page_url(cama)}')
    print(f'Ativa: {"sim" if cama.get("active") else "NÃO"} · Destaque: {"sim" if cama.get("featured") else "não"} · Ordem: {cama.get("order") or 0}')
    print(f'Capa: {cama.get("category_cover") or "(sem capa na subcategoria)"}')
    print(f'Resumo: {summary or "(vazio)"}')
    print(f'O que transforma: {question or "(sem título)"} — {n_items} item(ns) em negrito')
    print(f'\nProdutos ({len(items)}):')
    for p in items:
        point = by_slug.get(p['slug'])
        print(f'  - {p["slug"]} — {p.get("name", "")}' + (f'  + {fmt_point(point)}' if point else ''))
    issues = check(cama, items, points)
    print('\nPendências:' if issues else '\nSem pendências.')
    for issue in issues:
        print(f'  ⚠ {issue}')


def cmd_pontos(slug):
    print(json.dumps({'cama': slug, 'marcacoes': parse_marks(read_marks_text()).get(slug, [])}, ensure_ascii=False))


def write_marks(slug, new_points, aplicar):
    local_text = read_marks_text('local')
    remote_text = read_marks_text('remote')
    if local_text != remote_text:
        sys.exit(f'{MARKS_PATH} local é diferente do preview. Alguém mudou um dos dois: '
                 'confira (scripts/yampi-store-file get-current) antes de salvar.')
    marks = parse_marks(local_text)
    old_points = marks.get(slug, [])
    if new_points:
        marks[slug] = new_points
    else:
        marks.pop(slug, None)
    new_text = render_marks(local_text, marks)
    parse_marks(new_text)  # garante JSON válido
    if new_text == local_text:
        print('Nada a mudar: as marcações já estão assim.')
        return
    print('Antes:' if old_points else 'Antes: (sem marcações)')
    for p in old_points:
        print(f'  - {p["produto"]}: {fmt_point(p)}')
    print('Depois:' if new_points else 'Depois: (sem marcações)')
    for p in new_points:
        print(f'  - {p["produto"]}: {fmt_point(p)}')
    print('\nMudança no arquivo do tema:')
    sys.stdout.writelines(l for l in difflib.unified_diff(local_text.splitlines(True), new_text.splitlines(True), MARKS_PATH, MARKS_PATH, n=1))
    if not aplicar:
        print('\n(simulação — nada foi salvo. Rode de novo com --aplicar para salvar no preview.)')
        return
    (THEME / MARKS_PATH).write_text(new_text, encoding='utf-8')
    result = store_file('put', str(THEME / MARKS_PATH), MARKS_PATH)
    out = (result.stdout or b'').decode() + (result.stderr or b'').decode()
    if result.returncode or '"status":200' not in out.replace(' ', ''):
        (THEME / MARKS_PATH).write_text(local_text, encoding='utf-8')
        sys.exit(f'O envio ao preview falhou; arquivo local restaurado. Resposta: {out[:300]}')
    ok = read_marks_text('remote') == new_text
    print('\nSalvo no preview e relido: ' + ('OK, igual ao local.' if ok else 'ATENÇÃO — a releitura não bate; não reenvie, investigue.'))
    print('A loja publicada só muda quando o tema for publicado.')
    if not ok:
        sys.exit(1)


def cmd_salvar(raiz, path, slug_arg, aplicar):
    text = sys.stdin.read() if path == '-' else Path(path).read_text(encoding='utf-8')
    slug, points = parse_request(text)
    slug = slug_arg or slug
    if not slug:
        sys.exit('Não sei de qual cama são as marcações: informe o slug.')
    if slug_arg and slug_arg != (parse_request(text)[0] or slug_arg):
        sys.exit(f'As marcações são da cama "{parse_request(text)[0]}", não de "{slug_arg}".')
    _root, cama = find_cama(raiz, slug)
    points = normalize(points)
    produtos = [p['produto'] for p in points]
    if len(set(produtos)) != len(produtos):
        sys.exit('Há produto repetido nas marcações.')
    items = {p['slug'] for p in products(cama['id'])}
    missing = [p for p in produtos if p not in items]
    if missing:
        print(f'⚠ Fora da subcategoria (não vão aparecer até o produto entrar nela): {", ".join(missing)}\n')
    print(f'Cama: {cama["name"]} ({slug})')
    write_marks(slug, points, aplicar)


def cmd_tirar(raiz, slug, aplicar):
    find_cama(raiz, slug)
    write_marks(slug, [], aplicar)


# ---------- cama nova ----------

SLUG_RE = re.compile(r'[a-z0-9]+(?:-[a-z0-9]+)*')
SPEC_KEYS = {'nome', 'slug', 'resumo', 'pergunta', 'itens', 'capa', 'produtos', 'destaque', 'ordem', 'ativa'}


def load_spec(path):
    text = sys.stdin.read() if path == '-' else Path(path).read_text(encoding='utf-8')
    start = text.find('{')  # aceita o texto copiado da ferramenta: "Criar cama nova …:" + JSON
    try:
        spec, _end = json.JSONDecoder().raw_decode(text[start:]) if start >= 0 else (None, 0)
    except json.JSONDecodeError as error:
        sys.exit(f'A ficha da cama está incompleta ({error}). Copie de novo na ferramenta.')
    if not isinstance(spec, dict):
        sys.exit('O arquivo da cama precisa ser um objeto JSON (veja o modelo).')
    return validate_spec(spec)


def validate_spec(spec):
    """Confere o formato e devolve a especificação normalizada; erros em pt-BR."""
    errors = []
    extra = set(spec) - SPEC_KEYS - {'_instrucoes'}
    if extra:
        errors.append(f'campos desconhecidos: {", ".join(sorted(extra))}')
    nome = str(spec.get('nome') or '').strip()
    slug = str(spec.get('slug') or '').strip()
    resumo = str(spec.get('resumo') or '').strip()
    pergunta = str(spec.get('pergunta') or '').strip()
    capa = str(spec.get('capa') or '').strip()
    if not nome:
        errors.append('"nome" é obrigatório')
    if not SLUG_RE.fullmatch(slug):
        errors.append('"slug" é obrigatório: só letras minúsculas, números e hífens (ex.: cama-exemplo)')
    if not resumo:
        errors.append('"resumo" é obrigatório (1º parágrafo da página da cama)')
    itens = []
    for n, item in enumerate(spec.get('itens') or [], 1):
        titulo = str((item or {}).get('titulo') or '').strip() if isinstance(item, dict) else ''
        texto = str((item or {}).get('texto') or '').strip() if isinstance(item, dict) else ''
        if not titulo or not texto:
            errors.append(f'item {n} do "O que transforma…" precisa de "titulo" e "texto"')
        itens.append({'titulo': titulo, 'texto': texto})
    if itens and not pergunta:
        errors.append('"pergunta" é obrigatória quando há itens (título do bloco "O que transforma…")')
    if pergunta and not itens:
        errors.append('"pergunta" sem "itens": inclua de 3 a 5 itens')
    if capa and not re.match(r'https://', capa):
        errors.append('"capa" precisa ser um link https público da foto (ou vazio)')
    produtos = [str(p).strip() for p in spec.get('produtos') or []]
    bad = [p for p in produtos if not SLUG_RE.fullmatch(p)]
    if bad:
        errors.append(f'slugs de produto inválidos: {", ".join(bad)}')
    if len(set(produtos)) != len(produtos):
        errors.append('há produto repetido em "produtos"')
    ordem = spec.get('ordem')
    if ordem is not None and (not isinstance(ordem, int) or isinstance(ordem, bool) or ordem < 0):
        errors.append('"ordem" deve ser um número inteiro (ou ficar de fora)')
    for key in ('destaque', 'ativa'):
        if key in spec and not isinstance(spec[key], bool):
            errors.append(f'"{key}" deve ser true ou false')
    if errors:
        sys.exit('Corrija o arquivo da cama:\n  - ' + '\n  - '.join(errors))
    return {'nome': nome, 'slug': slug, 'resumo': resumo, 'pergunta': pergunta, 'itens': itens,
            'capa': capa, 'produtos': produtos, 'destaque': spec.get('destaque', False),
            'ordem': ordem, 'ativa': spec.get('ativa', True)}


def build_description(spec):
    """Mesmo formato lido por description_parts e pelo CamaIdealDetail.vue (sem <section> nem data-*)."""
    esc = lambda text: html.escape(text, quote=False)
    out = f'<p>{esc(spec["resumo"])}</p>'
    if spec['pergunta']:
        out += f'<h3>{esc(spec["pergunta"])}</h3>'
        for item in spec['itens']:
            paragraphs = [re.sub(r'\s+', ' ', part).strip() for part in re.split(r'\n\s*\n', item['texto'])]
            paragraphs = [part for part in paragraphs if part]
            out += f'<p><strong>{esc(item["titulo"])}</strong> {esc(paragraphs[0])}</p>'
            out += ''.join(f'<p>{esc(part)}</p>' for part in paragraphs[1:])
    return out


def all_products():
    found, page = [], 1
    while True:
        batch = api('GET', f'catalog/products?limit=100&page={page}')
        found += batch
        if len(batch) < 100 or page >= 20:
            return found
        page += 1


PRODUCT_INCLUDE = 'brand,texts,seo,extras,categories,variations,collections,skus'


def rel(product, name):
    value = (product.get(name) or {}).get('data')
    return value if value is not None else ({} if name in ('brand', 'texts', 'seo', 'extras') else [])


def product_full(product_id):
    """Produto com as relações (include; '.' entra um nível, ex.: skus.images)."""
    return api('GET', f'catalog/products/{product_id}?include={PRODUCT_INCLUDE}')


def product_snapshot(product):
    """Tudo o que a leitura mostra e o PUT pode alterar — comparado antes/depois."""
    texts, seo, extras = rel(product, 'texts'), rel(product, 'seo'), rel(product, 'extras')
    return {
        **{k: product.get(k) for k in ('name', 'slug', 'active', 'searchable', 'simple', 'is_digital', 'priority')},
        'brand_id': rel(product, 'brand').get('id'),
        **{k: texts.get(k) for k in ('description', 'specifications', 'measures')},
        **{k: seo.get(k) for k in ('seo_title', 'seo_description', 'seo_keywords')},
        'search_terms': extras.get('search_terms'),
        'variations_ids': sorted(v['id'] for v in rel(product, 'variations')),
        'collections_ids': sorted(c['id'] for c in rel(product, 'collections')),
        'categories_ids': sorted(c['id'] for c in rel(product, 'categories')),
        'skus': sorted((k['id'], k['sku']) for k in rel(product, 'skus')),
    }


def product_put_payload(product, categories_ids):
    """PUT completo a partir da leitura com include; sem `skus` (omitido preserva os SKUs)."""
    snap = product_snapshot(product)
    payload = {k: snap[k] for k in ('name', 'slug', 'active', 'searchable', 'simple', 'is_digital', 'priority',
                                    'brand_id', 'description', 'specifications', 'measures',
                                    'seo_title', 'seo_description', 'search_terms',
                                    'variations_ids', 'collections_ids')}
    payload['categories_ids'] = sorted(categories_ids)
    return {k: v for k, v in payload.items() if v is not None}


def unlink_product(product_id, cama_id):
    before = product_full(product_id)
    snap = product_snapshot(before)
    if cama_id not in snap['categories_ids']:
        return 'já não estava na cama'
    remaining = [c for c in snap['categories_ids'] if c != cama_id]
    api('PUT', f'catalog/products/{product_id}', product_put_payload(before, remaining))
    after = product_snapshot(product_full(product_id))
    expected = {**snap, 'categories_ids': sorted(remaining)}
    diff = [k for k in expected if after.get(k) != expected[k]]
    if diff:
        sys.exit(f'ATENÇÃO — o produto {snap["slug"]} mudou além da categoria ({", ".join(diff)}). '
                 'Parei sem mexer nos próximos; não reenvie, investigue.')
    return 'tirado da cama e relido OK'


def same_image(url, cover):
    """category_cover pode vir como nome de arquivo ou URL completa."""
    if not url or not cover:
        return False
    name = lambda value: value.split('?')[0].rstrip('/').rsplit('/', 1)[-1]
    return name(url) == name(cover)


def link_product(product_id, cama_id):
    before = product_full(product_id)
    snap = product_snapshot(before)
    if cama_id in snap['categories_ids']:
        return 'já estava na cama'
    api('PUT', f'catalog/products/{product_id}', product_put_payload(before, snap['categories_ids'] + [cama_id]))
    after = product_snapshot(product_full(product_id))
    expected = {**snap, 'categories_ids': sorted(snap['categories_ids'] + [cama_id])}
    diff = [k for k in expected if after.get(k) != expected[k]]
    if diff:
        sys.exit(f'ATENÇÃO — o produto {snap["slug"]} mudou além da categoria ({", ".join(diff)}). '
                 'Parei sem mexer nos próximos; não reenvie, investigue.')
    return 'vinculado e relido OK'


def url_ok(url):
    try:
        request = urllib.request.Request(url, method='HEAD', headers={'User-Agent': 'cama-ideal-check'})
        with urllib.request.urlopen(request, timeout=20) as response:
            return response.status == 200 and response.headers.get('Content-Type', '').startswith('image/')
    except Exception:
        return False


def cmd_criar(raiz, path, aplicar):
    spec = load_spec(path)
    cats = categories()
    root = next((c for c in cats if c['slug'] == raiz), None)
    if not root:
        sys.exit(f'Categoria raiz "{raiz}" não encontrada. Use --raiz <slug>.')
    siblings = [c for c in cats if c.get('parent_id') == root['id']]
    same_slug = next((c for c in cats if c['slug'] == spec['slug']), None)
    if same_slug and same_slug.get('parent_id') != root['id']:
        sys.exit(f'O slug "{spec["slug"]}" já é usado pela categoria "{same_slug["name"]}", fora da Cama Ideal. Escolha outro slug.')
    same_name = [c for c in siblings if c['name'].strip().lower() == spec['nome'].lower() and c is not same_slug]
    if same_name:
        sys.exit(f'Já existe uma cama chamada "{same_name[0]["name"]}" ({same_name[0]["slug"]}). Use o mesmo slug para completá-la, ou outro nome.')

    description = build_description(spec)
    ordem = spec['ordem'] if spec['ordem'] is not None else (
        same_slug.get('order') if same_slug else max([c.get('order') or 0 for c in siblings] + [0]) + 1)
    payload = {'active': spec['ativa'], 'name': spec['nome'], 'slug': spec['slug'], 'parent_id': root['id'],
               'featured': spec['destaque'], 'order': ordem, 'description': description,
               'seo_description': spec['resumo'][:160]}
    if same_slug:  # completar uma cama existente: preserva os demais campos
        payload = {**{k: same_slug.get(k) for k in PUT_FIELDS if k in same_slug}, **payload}

    current_items = products(same_slug['id']) if same_slug else []
    current_slugs = [p['slug'] for p in current_items]
    to_remove = [p for p in current_items if p['slug'] not in spec['produtos']]
    by_slug = {p['slug']: p for p in all_products()} if spec['produtos'] else {}
    missing = [p for p in spec['produtos'] if p not in by_slug]
    old_description = (same_slug.get('description') or '').strip() if same_slug else ''
    capa_changes = bool(spec['capa']) and not (same_slug and same_image(spec['capa'], same_slug.get('category_cover')))
    capa_ok = url_ok(spec['capa']) if spec['capa'] else None
    other_featured = [c['name'] for c in siblings if c.get('featured') and c is not same_slug]

    print(('Alterar a cama existente' if same_slug else 'Criar a cama nova') + f' em {root["name"]} ({raiz}):\n')
    print(f'  Nome: {spec["nome"]}')
    print(f'  Slug: {spec["slug"]}  →  página {root.get("url", "").split("?")[0].rstrip("/")}/{spec["slug"]}')
    print(f'  Ativa: {"sim" if spec["ativa"] else "não"} · Destaque: {"sim" if spec["destaque"] else "não"} · Ordem: {ordem}')
    print(f'  Resumo: {spec["resumo"]}')
    if spec['pergunta']:
        print(f'  O que transforma: {spec["pergunta"]}')
        for item in spec['itens']:
            print(f'    • {item["titulo"]} — {item["texto"]}')
    else:
        print('  O que transforma: (sem bloco)')
    capa_txt = spec['capa'] or '(sem capa — a foto virá de um banner com o mesmo slug, se houver)'
    if same_slug and spec['capa'] and not capa_changes:
        capa_txt = '(a mesma de hoje)'
    print(f'  Capa: {capa_txt}')
    if spec['produtos'] or to_remove:
        print('  Peças da cama:')
        for slug in spec['produtos']:
            tag = '' if not same_slug else (' (já está)' if slug in current_slugs else ' (entra)')
            print(f'    - {slug} — {by_slug[slug].get("name", "")}{tag}' if slug in by_slug else f'    - {slug} — ⚠ NÃO ENCONTRADO na loja')
        for item in to_remove:
            print(f'    - {item["slug"]} — {item.get("name", "")} (SAI da cama; o produto continua na loja)')
    if same_slug:
        if old_description == description:
            print('\nTextos: sem mudança.')
        else:
            print('\nTextos — como está hoje:\n  ' + (old_description or '(vazio)'))
            print('Textos — como vai ficar:\n  ' + description)
    else:
        print('\nDescrição que vai para a Yampi:\n  ' + description)

    warnings = []
    if same_slug:
        warnings.append('a cama já existe: nome, textos e destaque serão substituídos pelos da ficha')
        if to_remove:
            warnings.append(f'{len(to_remove)} peça(s) vão sair desta cama (o produto não é apagado)')
    if missing:
        warnings.append(f'produto(s) não encontrado(s): {", ".join(missing)} — confira o slug no admin; não gravo enquanto houver')
    if spec['capa'] and not capa_ok:
        warnings.append('o link da capa não abriu como imagem — confira se é público e aponta direto para a foto')
    if spec['destaque'] and other_featured:
        warnings.append(f'já há cama em destaque ({", ".join(other_featured)}); desmarque no admin para esta ser a da vez')
    if not 3 <= len(spec['itens']) <= 5 and spec['itens']:
        warnings.append(f'o "O que transforma…" costuma ter de 3 a 5 itens (este tem {len(spec["itens"])})')
    for warning in warnings:
        print(f'\n⚠ {warning}')

    if not aplicar:
        print('\n(simulação — nada foi salvo. Rode de novo com --aplicar, depois da confirmação, para gravar na Yampi.)')
        return
    if spec['capa'] and not capa_ok:
        sys.exit('\nNão gravei: corrija o link da capa ou deixe "capa" vazio.')
    if missing:
        sys.exit('\nNão gravei: há produto não encontrado.')

    saved = api('PUT', f'catalog/categories/{same_slug["id"]}', payload) if same_slug else api('POST', 'catalog/categories', payload)
    cama_id = saved['id']
    if capa_changes:
        current = api('GET', f'catalog/categories/{cama_id}')
        api('PUT', f'catalog/categories/{cama_id}', {**{k: current.get(k) for k in PUT_FIELDS if k in current}, 'category_cover': spec['capa']})
    check_cat = api('GET', f'catalog/categories/{cama_id}')
    problems = []
    for key in ('name', 'slug', 'parent_id', 'active', 'featured', 'order'):
        if check_cat.get(key) != payload[key]:
            problems.append(f'{key}: esperado {payload[key]!r}, ficou {check_cat.get(key)!r}')
    if (check_cat.get('description') or '').strip() != description:
        problems.append('descrição gravada diferente da enviada (a Yampi pode ter alterado o HTML)')
    if spec['capa'] and not check_cat.get('category_cover'):
        problems.append('capa não ficou gravada')
    print(f'\nGravado na Yampi (id {cama_id}) e relido: ' + ('OK.' if not problems else 'ATENÇÃO — não reenvie, investigue:'))
    for problem in problems:
        print(f'  ⚠ {problem}')
    if problems:
        sys.exit(1)
    for slug in spec['produtos']:
        if slug not in current_slugs:
            print(f'  - {slug}: {link_product(by_slug[slug]["id"], cama_id)}')
    for item in to_remove:
        print(f'  - {item["slug"]}: {unlink_product(item["id"], cama_id)}')
    print('Vale na hora na loja (catálogo não depende de publicar o tema).')
    print('\nPróximos passos: `ver ' + spec['slug'] + '` → marcar os "+" na ferramenta.')


def main(argv):
    raiz = 'cama-do-mes'
    if '--raiz' in argv:
        i = argv.index('--raiz')
        raiz = argv[i + 1]
        del argv[i:i + 2]
    aplicar = '--aplicar' in argv
    argv = [a for a in argv if a != '--aplicar']
    if not argv:
        sys.exit(__doc__)
    cmd, args = argv[0], argv[1:]
    if cmd == 'status' and not args:
        return cmd_status(raiz)
    if cmd == 'ver' and len(args) == 1:
        return cmd_ver(raiz, args[0])
    if cmd == 'pontos' and len(args) == 1:
        return cmd_pontos(args[0])
    if cmd == 'salvar-pontos' and len(args) in (1, 2):
        return cmd_salvar(raiz, args[0], args[1] if len(args) == 2 else '', aplicar)
    if cmd == 'tirar-pontos' and len(args) == 1:
        return cmd_tirar(raiz, args[0], aplicar)
    if cmd in ('criar', 'editar') and len(args) == 1:
        return cmd_criar(raiz, args[0], aplicar)
    sys.exit(__doc__)


if __name__ == '__main__':
    main(sys.argv[1:])
